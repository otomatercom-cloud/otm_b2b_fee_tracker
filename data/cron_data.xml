<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_b2bfee_refresh_status" model="ir.cron">
        <field name="name">B2B Fees: refresh installment status</field>
        <field name="model_id" ref="model_otm_b2bfee_installment"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_status()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_b2bfee_send_reminders" model="ir.cron">
        <field name="name">B2B Fees: send due and overdue reminders</field>
        <field name="model_id" ref="model_otm_b2bfee_installment"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_b2bfee_team_whatsapp" model="ir.cron">
        <field name="name">B2B Fees: WhatsApp digest to accounts team and directors</field>
        <field name="model_id" ref="model_otm_b2bfee_staff"/>
        <field name="state">code</field>
        <field name="code">env["otm.b2bfee.internal.notify"]._cron_internal_notifications()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

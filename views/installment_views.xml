<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2bfee_installment_list" model="ir.ui.view">
        <field name="name">otm.b2bfee.installment.list</field>
        <field name="model">otm.b2bfee.installment</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="state == 'overdue'"
                  decoration-success="state == 'paid'" decoration-warning="state == 'due'">
                <field name="college_id"/>
                <field name="program_id" optional="show"/>
                <field name="batch_id"/>
                <field name="term_name"/>
                <field name="due_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="paid_amount" sum="Total"/>
                <field name="balance" sum="Total"/>
                <field name="days_overdue"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'overdue'" decoration-success="state == 'paid'"
                       decoration-warning="state in ('due', 'partial')"/>
            </list>
        </field>
    </record>

    <record id="view_b2bfee_installment_form" model="ir.ui.view">
        <field name="name">otm.b2bfee.installment.form</field>
        <field name="model">otm.b2bfee.installment</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="upcoming,due,partial,paid"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group name="grp_main">
                        <group name="grp_ref">
                            <field name="college_id"/>
                            <field name="program_id"/>
                            <field name="batch_id"/>
                            <field name="term_name" readonly="1"/>
                            <field name="due_date"/>
                        </group>
                        <group name="grp_amounts">
                            <field name="amount" readonly="1"/>
                            <field name="paid_amount"/>
                            <field name="balance"/>
                            <field name="days_overdue"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="page_allocs" string="Payments Received">
                            <field name="alloc_ids" readonly="1">
                                <list>
                                    <field name="payment_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="payment_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_b2bfee_installment_search" model="ir.ui.view">
        <field name="name">otm.b2bfee.installment.search</field>
        <field name="model">otm.b2bfee.installment</field>
        <field name="arch" type="xml">
            <search>
                <field name="college_id"/>
                <field name="batch_id"/>
                <field name="program_id"/>
                <field name="term_name"/>
                <filter name="filter_overdue" string="Overdue" domain="[('state', '=', 'overdue')]"/>
                <filter name="filter_due" string="Due Soon" domain="[('state', '=', 'due')]"/>
                <filter name="filter_partial" string="Partially Paid" domain="[('state', '=', 'partial')]"/>
                <filter name="filter_upcoming" string="Upcoming" domain="[('state', '=', 'upcoming')]"/>
                <filter name="filter_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="filter_unpaid" string="All Unpaid" domain="[('state', '!=', 'paid')]"/>
                <separator/>
                <group>
                    <filter name="group_college" string="College" context="{'group_by': 'college_id'}"/>
                    <filter name="group_program" string="Program" context="{'group_by': 'program_id'}"/>
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_due_month" string="Due Month" context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_b2bfee_installment" model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">otm.b2bfee.installment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_unpaid': 1}</field>
    </record>
</odoo>

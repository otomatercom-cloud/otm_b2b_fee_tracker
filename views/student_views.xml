<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2bfee_student_list" model="ir.ui.view">
        <field name="name">otm.b2bfee.student.list</field>
        <field name="model">otm.b2bfee.student</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'dropped'">
                <field name="name"/>
                <field name="phone"/>
                <field name="email" optional="show"/>
                <field name="college_id"/>
                <field name="program_id"/>
                <field name="batch_id"/>
                <field name="registration_date" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="discount_amount" optional="hide"/>
                <field name="fee" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_b2bfee_student_form" model="ir.ui.view">
        <field name="name">otm.b2bfee.student.form</field>
        <field name="model">otm.b2bfee.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group name="grp_main">
                        <group name="grp_student">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="registration_date"/>
                        </group>
                        <group name="grp_fee">
                            <field name="batch_id"/>
                            <field name="college_id"/>
                            <field name="program_id"/>
                            <field name="discount_amount"/>
                            <field name="fee"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_b2bfee_student_search" model="ir.ui.view">
        <field name="name">otm.b2bfee.student.search</field>
        <field name="model">otm.b2bfee.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="college_id"/>
                <field name="batch_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_dropped" string="Dropped" domain="[('state', '=', 'dropped')]"/>
                <separator/>
                <group>
                    <filter name="group_college" string="College" context="{'group_by': 'college_id'}"/>
                    <filter name="group_program" string="Program" context="{'group_by': 'program_id'}"/>
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_b2bfee_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">otm.b2bfee.student</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

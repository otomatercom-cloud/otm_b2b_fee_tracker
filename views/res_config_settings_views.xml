<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_b2bfee" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.b2bfee</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="B2B Fees" name="otm_b2b_fee_tracker"
                     groups="otm_b2b_fee_tracker.group_b2bfee_manager">
                    <block title="Students" name="b2bfee_students_block">
                        <setting id="b2bfee_students_setting" string="Enter individual students"
                                 help="Off: just enter the number of students in each batch. On: you can also register students one by one, with per-student discounts; the batch then uses the registered students.">
                            <field name="group_b2bfee_students"/>
                        </setting>
                    </block>
                    <block title="Reminders" name="b2bfee_reminders_block">
                        <setting id="b2bfee_due_window" string="Due-soon window"
                                 help="Installments due within this many days are flagged 'Due Soon'.">
                            <field name="b2bfee_due_window_days"/>
                        </setting>
                        <setting id="b2bfee_before_days" string="Before due date"
                                 help="Comma separated days before the due date to remind, e.g. 7,3. A reminder is also sent on the due date.">
                            <field name="b2bfee_reminder_before"/>
                        </setting>
                        <setting id="b2bfee_overdue_days_setting" string="After due date"
                                 help="Comma separated days after the due date to chase, e.g. 1,7,15.">
                            <field name="b2bfee_overdue_days"/>
                        </setting>
                        <setting id="b2bfee_escalate_setting" string="Escalation"
                                 help="Fee Managers get a task once an installment is overdue by this many days.">
                            <field name="b2bfee_escalate_from"/>
                        </setting>
                    </block>
                    <block title="Emails" name="b2bfee_emails_block">
                        <setting id="b2bfee_email_college_setting" string="Email reminders to college"
                                 help="Send due and overdue reminders to the college contact email.">
                            <field name="b2bfee_email_college"/>
                        </setting>
                        <setting id="b2bfee_email_receipt_setting" string="Email receipt on posting"
                                 help="Send the PDF receipt to the college when a payment is posted.">
                            <field name="b2bfee_email_receipt"/>
                        </setting>
                    </block>
                    <block title="WhatsApp (Meta Cloud API)" name="b2bfee_whatsapp_block">
                        <setting id="b2bfee_wa_enabled_setting" string="WhatsApp reminders"
                                 help="Send the same due and overdue reminders to the college WhatsApp number using approved templates.">
                            <field name="b2bfee_wa_enabled"/>
                        </setting>
                        <setting id="b2bfee_wa_receipt_setting" string="WhatsApp receipt"
                                 help="Send a receipt message when a payment is posted.">
                            <field name="b2bfee_wa_receipt"/>
                        </setting>
                        <setting id="b2bfee_wa_phone_id_setting" string="Phone Number ID"
                                 help="From Meta Business: WhatsApp &gt; API Setup. This is the ID, not the phone number.">
                            <field name="b2bfee_wa_phone_number_id"/>
                        </setting>
                        <setting id="b2bfee_wa_token_setting" string="Access token"
                                 help="Permanent system-user token with whatsapp_business_messaging permission. Stored in system parameters, visible only to administrators.">
                            <field name="b2bfee_wa_token" password="True"/>
                        </setting>
                        <setting id="b2bfee_wa_version_setting" string="Graph API version"
                                 help="Keep v21.0 unless Meta asks you to change it.">
                            <field name="b2bfee_wa_api_version"/>
                        </setting>
                        <setting id="b2bfee_wa_language_setting" string="Template language code"
                                 help="Must match the language of your templates in WhatsApp Manager: en for English, en_US for English (US), en_GB for English (UK).">
                            <field name="b2bfee_wa_language"/>
                        </setting>
                        <setting id="b2bfee_wa_country_setting" string="Default country code"
                                 help="Added to 10-digit numbers, e.g. 91 for India.">
                            <field name="b2bfee_wa_country_code"/>
                        </setting>
                        <setting id="b2bfee_wa_tpl_upcoming_setting" string="College reminder template"
                                 help="Template name for the due-soon reminder to colleges. Variables: 1 name, 2 term, 3 program, 4 due date, 5 balance.">
                            <field name="b2bfee_wa_tpl_upcoming"/>
                        </setting>
                        <setting id="b2bfee_wa_tpl_overdue_setting" string="College overdue template"
                                 help="Template name for the overdue notice to colleges. Variables: 1 name, 2 term, 3 program, 4 due date, 5 days overdue, 6 balance.">
                            <field name="b2bfee_wa_tpl_overdue"/>
                        </setting>
                        <setting id="b2bfee_wa_tpl_receipt_setting" string="College receipt template"
                                 help="Template name for the payment receipt to colleges. Variables: 1 name, 2 amount, 3 receipt no, 4 program, 5 balance pending.">
                            <field name="b2bfee_wa_tpl_receipt"/>
                        </setting>
                        <setting id="b2bfee_wa_tpl_summary_setting" string="Team summary template"
                                 help="Template name for the accounts/director summary. Needs 8 variables: 1 date, 2 total colleges, 3 colleges with pending, 4 collected, 5 pending, 6 overdue, 7 due in 7 days, 8 top colleges by pending.">
                            <field name="b2bfee_wa_tpl_summary"/>
                        </setting>
                        <setting id="b2bfee_wa_tpl_staff_payment_setting" string="Team payment alert template"
                                 help="Template name for payment-received alerts. Needs 5 variables: 1 college, 2 amount, 3 program, 4 receipt, 5 batch pending.">
                            <field name="b2bfee_wa_tpl_staff_payment"/>
                        </setting>
                        <setting id="b2bfee_wa_tpl_staff_escalation_setting" string="Team escalation template"
                                 help="Template name for escalation alerts. Needs 5 variables: 1 college, 2 term, 3 program, 4 days overdue, 5 balance.">
                            <field name="b2bfee_wa_tpl_staff_escalation"/>
                        </setting>
                        <setting id="b2bfee_wa_test_setting" string="Send a test"
                                 help="Saves the settings and sends the 'Upcoming' template with sample values.">
                            <field name="b2bfee_wa_test_number" placeholder="e.g. 98470 12345"/>
                            <button name="action_b2bfee_wa_test" type="object"
                                    string="Send test message" class="btn-link"/>
                        </setting>
                    </block>
                    <block title="Data" name="b2bfee_data_block" groups="otm_b2b_fee_tracker.group_b2bfee_manager">
                        <setting id="b2bfee_demo_setting" string="Demo data"
                                 help="Sample colleges, batches and payments so you can try the dashboard. Removing demo data never touches your own records.">
                            <div class="mt8">
                                <button name="action_b2bfee_load_demo" type="object" string="Load demo data"
                                        class="btn-secondary me-2"/>
                                <button name="action_b2bfee_remove_demo" type="object" string="Remove demo data"
                                        class="btn-secondary"
                                        confirm="Remove the demo colleges, batches and payments?"/>
                            </div>
                        </setting>
                        <setting id="b2bfee_wipe_setting" string="Delete all fee data"
                                 help="Permanently deletes every college, batch, student, installment, payment and reminder log. Programs are removed too. This cannot be undone.">
                            <div class="mt8">
                                <button name="action_b2bfee_remove_all" type="object" string="Delete all data"
                                        class="btn-danger"
                                        confirm="This permanently deletes ALL colleges, batches, students, installments and payments. Continue?"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>

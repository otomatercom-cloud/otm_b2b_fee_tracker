<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2bfee_staff_list" model="ir.ui.view">
        <field name="name">otm.b2bfee.staff.list</field>
        <field name="model">otm.b2bfee.staff</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role"/>
                <field name="whatsapp_number"/>
                <field name="daily_digest" optional="show"/>
                <field name="weekly_summary" optional="show"/>
                <field name="payment_alerts" optional="show"/>
                <field name="escalations" optional="show"/>
                <field name="last_result" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_b2bfee_staff_form" model="ir.ui.view">
        <field name="name">otm.b2bfee.staff.form</field>
        <field name="model">otm.b2bfee.staff</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_summary_now" string="Send Summary Now" type="object"
                            class="btn-primary" invisible="not id"/>
                    <button name="action_send_test_escalation" string="Send Test Escalation" type="object"
                            invisible="not id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Name"/></h1></div>
                    <group name="grp_main">
                        <group name="grp_who" string="Recipient">
                            <field name="role"/>
                            <field name="whatsapp_number" placeholder="e.g. 98470 12345"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="grp_what" string="Send me">
                            <field name="daily_digest"/>
                            <field name="weekly_summary"/>
                            <field name="payment_alerts"/>
                            <field name="escalations"/>
                        </group>
                    </group>
                    <group name="grp_status" string="Status">
                        <field name="last_daily"/>
                        <field name="last_weekly"/>
                        <field name="last_result"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_b2bfee_staff_search" model="ir.ui.view">
        <field name="name">otm.b2bfee.staff.search</field>
        <field name="model">otm.b2bfee.staff</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="whatsapp_number"/>
                <filter name="filter_accounts" string="Accounts Team" domain="[('role', '=', 'accounts')]"/>
                <filter name="filter_director" string="Directors" domain="[('role', '=', 'director')]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_b2bfee_staff" model="ir.actions.act_window">
        <field name="name">Team WhatsApp Alerts</field>
        <field name="res_model">otm.b2bfee.staff</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

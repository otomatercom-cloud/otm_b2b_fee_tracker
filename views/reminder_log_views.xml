<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2bfee_reminder_log_list" model="ir.ui.view">
        <field name="name">otm.b2bfee.reminder.log.list</field>
        <field name="model">otm.b2bfee.reminder.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="sent_on"/>
                <field name="college_id"/>
                <field name="batch_id"/>
                <field name="installment_id"/>
                <field name="kind"/>
                <field name="trigger_key" optional="hide"/>
                <field name="email_sent"/>
                <field name="email_to" optional="show"/>
                <field name="activity_created"/>
                <field name="escalated"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_b2bfee_reminder_log_search" model="ir.ui.view">
        <field name="name">otm.b2bfee.reminder.log.search</field>
        <field name="model">otm.b2bfee.reminder.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="college_id"/>
                <field name="batch_id"/>
                <field name="installment_id"/>
                <filter name="filter_overdue" string="Overdue" domain="[('kind', '=', 'overdue')]"/>
                <filter name="filter_escalated" string="Escalated" domain="[('escalated', '=', True)]"/>
                <filter name="filter_no_email" string="No Email Sent" domain="[('email_sent', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_college" string="College" context="{'group_by': 'college_id'}"/>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'sent_on:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_b2bfee_reminder_log" model="ir.actions.act_window">
        <field name="name">Reminder Log</field>
        <field name="res_model">otm.b2bfee.reminder.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
